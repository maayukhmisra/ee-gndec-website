{#
/**
 * @file
 * View template for Academic Documents block displays.
 */
#}
<div class="academic-documents-section w-100">
  {% if display_id == 'sanctioned_seats' %}
    <h2 class="programmes-section-heading">Seats in Programmes</h2>
  {% elseif display_id == 'btech_schemes' %}
    <h2 class="programmes-section-heading mb-3">Scheme & Syllabus</h2>
    <h3 class="programmes-subgroup-heading"><span class="bullet-dot">•</span> B.TECH SYLLABUS & STUDY SCHEMES</h3>
  {% elseif display_id == 'mtech_schemes' %}
    <h3 class="programmes-subgroup-heading"><span class="bullet-dot">•</span> M.TECH SYLLABUS & SCHEMES</h3>
  {% elseif display_id == 'phd_schemes' %}
    <h3 class="programmes-subgroup-heading"><span class="bullet-dot">•</span> PH.D. SYLLABUS & STUDY SCHEME</h3>
  {% elseif display_id == 'prerequisites' %}
    <h2 class="programmes-section-heading mt-4">Schematics of the Prerequisites</h2>
  {% endif %}

  <div class="doc-rows-stack">
    {% for doc in doc_rows %}
      <div class="doc-row-card">
        <div class="doc-row-left">
          <div class="doc-pdf-icon-badge">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <div class="doc-row-details">
            <span class="doc-row-title">{{ doc.title }}</span>
            {% if doc.upload_date %}
              <span class="doc-upload-date">{{ doc.upload_date }}</span>
            {% endif %}
          </div>
        </div>

        <div class="doc-row-right">
          {% if doc.pdf_url %}
            <a href="{{ doc.pdf_url }}" target="_blank" rel="noopener noreferrer" class="doc-view-pdf-link">
              View &rarr;
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>
