<?php

/**
 * @file
 * Functions to support theming in the GNDEC theme.
 */

use Drupal\Component\Utility\Html;

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function gndec_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  // Add page template suggestions based on current path alias.
  $path = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($path);
  $alias_clean = trim($alias, '/');

  if ($alias_clean) {
    $parts = explode('/', $alias_clean);
    $suggestion = 'page';
    foreach ($parts as $part) {
      $clean_part = str_replace('-', '_', Html::cleanCssIdentifier($part));
      $suggestion .= '__' . $clean_part;
      $suggestions[] = $suggestion;
    }
  }
}

/**
 * Implements hook_preprocess_html().
 */
function gndec_preprocess_html(&$variables) {
  // Add path alias clean class to body tag.
  $path = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($path);
  $alias_clean = trim($alias, '/');

  if ($alias_clean) {
    $variables['attributes']['class'][] = 'path-' . Html::cleanCssIdentifier(str_replace('/', '-', $alias_clean));
  }
}
