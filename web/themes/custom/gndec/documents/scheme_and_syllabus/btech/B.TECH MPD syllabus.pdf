                    <!-- form card login -->
                    <div class="card rounded-0">
                        <div class="card-header">
                            <h3 class="mb-0">GNDEC: Login Portal</h3>
                        </div>
                        <div class="card-body">
                         
                            <form class="form" role="form"  action="" autocomplete="off"  accept-charset="UTF-8" id="formLogin" novalidate="" method="POST">
                                <div class="form-group">
									
                                    <label for="uname1">Username</label>
                                    <input type="text" class="form-control form-control-lg rounded-0" style="font-size:14pt;height:37px" name="username" id="username"  required="">
                                
                                </div>
                                <div class="form-group">
                                    <label>Password</label>
                                    <input type="password" class="form-control form-control-lg rounded-0" style="font-size:14pt;height:37px" name="password" id="password" required="" >
                                   <!-- <div class="invalid-feedback">Enter your password too!</div>-->
                                </div>
                                <div>
                                    
                                </div>
                                <br>
                                <button type="submit" class="btn btn-danger btn-lg float-right" id="btnLogin">Sign In</button>
                            </form>
                        </div>
                        <!--/card-block-->
                    </div>
                    <!-- /form card login -->

                </div>


            </div>
            <!--/row-->

        </div>
        <!--/col-->
