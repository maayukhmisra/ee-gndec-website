{#
/**
 * @file
 * Theme implementation to display the 'People' page.
 *
 * Available variables:
 * - page: An array of elements to render.
 */
#}
{{ attach_library('gndec/global-styling') }}
{{ attach_library('gndec/header-styles') }}
{{ attach_library('gndec/people-page-styles') }}

{# 1. Top Global Navigation Bar #}
{% include directory ~ '/templates/header.html.twig' %}


{# 2. Full-Width Hero Region #}
{% if page.hero %}
  <div class="hero-banner w-100 p-0">
    {{ page.hero }}
  </div>
{% endif %}

{# 3. Main Body Container for People Page #}
<main class="py-0 py-md-5 main-content-bg people-page-wrapper">
  <div class="container">
    <div class="main-content-blocks-wrapper">
      {{ page.content }}
    </div>
  </div>
</main>

{# 4. Global Dark Footer #}
<footer class="site-footer bg-navy text-white pt-5 pb-3">
  <div class="container px-4 px-lg-5">
    {% if page.footer_col_1 or page.footer_col_2 or page.footer_col_3 %}
      <div class="footer-blocks-grid pb-4 mb-2">
        <div class="footer-block">{{ page.footer_col_1 }}</div>
        <div class="footer-block">{{ page.footer_col_2 }}</div>
        <div class="footer-block">{{ page.footer_col_3 }}</div>
      </div>
    {% endif %}

    <div class="footer-bottom-bar text-center pt-3">
      {% if page.footer_bottom %}
        {{ page.footer_bottom }}
      {% else %}
        <p class="mb-0 copyright-text">© 2026 Department of Computer Science & Engineering, GNE Ludhiana. All rights reserved.</p>
      {% endif %}
    </div>
  </div>
</footer>
